<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{ ticket.creditNote ? 'Abono' : 'Ticket' }} {{ ticket.reference }}</title>
    <style>
        @page { margin: 0; }
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
{# dompdf ignores box-sizing: the text width is the paper minus both margins,
   so nothing (text, logo, barcode) runs past the right edge. 302 px = 80 mm. #}
{% set paperPx = ticket.ticketWidthPx and ticket.ticketWidthPx < 302 ? ticket.ticketWidthPx : 302 %}
{% set marginLeftPx = marginLeftPx is defined ? marginLeftPx : 8 %}
{% set marginRightPx = marginRightPx is defined ? marginRightPx : 8 %}
            width: {{ paperPx - marginLeftPx - marginRightPx }}px;
            margin: 0;
            padding: 8px {{ marginRightPx }}px 8px {{ marginLeftPx }}px;
            overflow-wrap: break-word;
            word-wrap: break-word;
            color: #000;
        }
        .center { text-align: center; }
        img { max-width: 100%; }
        .bold { font-weight: bold; }
        .large { font-size: 16px; }
        .line {
            border-top: 1px dashed #000;
            margin: 6px 0;
        }
        .right { text-align: right; }
        .item { margin-bottom: 4px; }
        .item-name { font-weight: bold; }
        .qr { text-align: center; margin: 10px 0; }
        .qr img { width: 120pt; height: 120pt; }
        .barcode { text-align: center; margin: 10px 0 4px; }
        .footer { text-align: center; margin-top: 10px; font-size: 11px; }
    </style>
</head>
<body>
    {% if fiscalQrPath is defined and fiscalQrPath %}
    <div style="text-align:center; margin-bottom:6pt;">
        <div style="font-weight:bold;">{{ fiscalQrTitle }}</div>
        {# 32 mm: within the 30-40 mm the AEAT requires #}
        <img src="{{ fiscalQrPath }}" alt="QR tributario" style="width:32mm;height:32mm;">
        <div style="font-weight:bold;">{{ fiscalQrLegend }}</div>
    </div>
    {% endif -%}
    {% if logoPath %}
    <div style="text-align:center; margin-bottom:8px;">
        <img src="{{ logoPath }}" style="max-width:100%; height:auto;" alt="Logo">
    </div>
    {% endif %}
    <div class="center bold large">{{ ticket.storeName }}</div>
{# Issuer lines sit at column 0 so an empty block renders nothing at all. #}
{% if ticket.legalName and ticket.legalName != ticket.storeName %}
    <div class="center">{{ ticket.legalName }}</div>
{% endif %}
{% if ticket.taxId %}
    <div class="center">NIF: {{ ticket.taxId }}</div>
{% endif %}
    {% if ticket.storeAddress %}
        <div class="center">{{ ticket.storeAddress }}</div>
    {% endif %}
    {% if ticket.ticketHeader %}
        <div class="center">{{ ticket.ticketHeader|nl2br }}</div>
    {% endif %}
    {% if ticket.creditNote %}
        <div class="center bold large">ABONO {{ ticket.creditNote.number }}</div>
    {% endif %}
    <div class="center">{{ ticket.date|date('d/m/Y H:i') }}</div>
    {% if ticket.creditNote %}
        <div class="center">Rectifica: {{ ticket.creditNote.rectifiesReference }}{% if ticket.creditNote.rectifiesDate %} ({{ ticket.creditNote.rectifiesDate|date('d/m/Y') }}){% endif %}</div>
        <div class="center">Motivo: {{ ticket.creditNote.reason }}</div>
    {% else %}
        <div class="center">Ref: {{ ticket.reference }}</div>
{# PRD S5, at column 0 like the issuer lines: without a web reference it renders nothing. #}
{% if ticket.webOrderReference %}
        <div class="center">Pedido web: {{ ticket.webOrderReference }}</div>
{% endif %}
    {% endif %}
    <div class="center">Cajero: {{ ticket.cashierName }}</div>

    <div class="line"></div>

    {% for line in ticket.lines %}
        <div class="item">
            <div class="item-name">{{ line.name }}</div>
            {% if not giftMode %}
                <div>{{ line.quantity }} x {{ line.unitPrice|number_format(2, ',', '.') }} € = {{ line.lineTotal|number_format(2, ',', '.') }} €</div>
            {% else %}
                <div>Cant: {{ line.quantity }}</div>
            {% endif %}
        </div>
    {% endfor %}

    <div class="line"></div>

    {% if ticket.creditNote %}
        <div class="right">Base: {{ ticket.subtotal|number_format(2, ',', '.') }} €</div>
        <div class="right">IVA: {{ ticket.tax|number_format(2, ',', '.') }} €</div>
        <div class="right bold large">TOTAL DEVUELTO: {{ ticket.total|number_format(2, ',', '.') }} €</div>
        <div class="line"></div>
        {% if ticket.creditNote.exchangeCredit is not null %}<div>Aplicado a cambio: {{ ticket.creditNote.exchangeCredit|number_format(2, ',', '.') }} €</div>
        {% endif %}{% if ticket.creditNote.cashAmount > 0 %}<div>Efectivo: {{ ticket.creditNote.cashAmount|number_format(2, ',', '.') }} €</div>{% endif %}
        {% if ticket.creditNote.cardAmount > 0 %}<div>Tarjeta: {{ ticket.creditNote.cardAmount|number_format(2, ',', '.') }} €</div>{% endif %}
        {% if ticket.creditNote.webRefundAmount > 0 %}<div class="bold">Reembolso pendiente en la web: {{ ticket.creditNote.webRefundAmount|number_format(2, ',', '.') }} €</div>
        {% endif %}{% if ticket.creditNote.voucherCode %}<div class="bold">Vale: {{ ticket.creditNote.voucherCode }}  {{ ticket.creditNote.voucherAmount|number_format(2, ',', '.') }} €</div>{% endif %}
    {% elseif not giftMode %}
        <div class="right">Subtotal: {{ ticket.subtotal|number_format(2, ',', '.') }} €</div>
        <div class="right">IVA: {{ ticket.tax|number_format(2, ',', '.') }} €</div>
        <div class="right bold large">TOTAL: {{ ticket.total|number_format(2, ',', '.') }} €</div>

        <div class="line"></div>

        {% if ticket.exchangeCredit is not null %}<div>Abono aplicado: {{ ticket.exchangeCredit|number_format(2, ',', '.') }} €</div>
        {% if ticket.exchangeCreditNote %}<div>Abono: {{ ticket.exchangeCreditNote }}</div>
        {% endif %}{% endif %}<div>Metodo: {{ ticket.exchangeCredit is not null ? ticket.paymentMethodLabel() : ticket.paymentMethod|capitalize }}</div>
        {% if ticket.paymentMethod != 'exchange' %}<div>Entrega: {{ ticket.amountTendered|number_format(2, ',', '.') }} €</div>
        {% endif %}{% if ticket.changeDue > 0 %}
            <div>Cambio: {{ ticket.changeDue|number_format(2, ',', '.') }} €</div>
        {% endif %}
    {% endif %}

    {% if not ticket.creditNote and barcodePath|default('') %}
    <div class="barcode">
        <img src="{{ barcodePath }}" alt="Código de barras" style="width:100%;height:36pt;">
        <div>{{ ticket.reference }}</div>
    </div>
    {% endif %}

    <div class="qr">
        {% if qrPath %}
            <img src="{{ qrPath }}" alt="QR" style="width:120pt;height:120pt;">
        {% endif %}
    </div>

    <div class="footer">{{ (ticket.ticketFooter ?: 'Gracias por su compra')|nl2br }}</div>
</body>
</html>
