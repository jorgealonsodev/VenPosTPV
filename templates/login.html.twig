    <script src="{{ base_path }}/assets/js/components/LoginScreen.js?v=30261104-security-v1"></script>
    <script nonce="{{ csp_nonce }}">
        const { createApp } = Vue;
        const app = createApp({
            components: { LoginScreen },
            template: `<login-screen />`
        });
        app.mount('#app');
