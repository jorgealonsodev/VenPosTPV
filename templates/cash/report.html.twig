<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Informe {{ report.kind }}</title>
    <style>
        @page { margin: 12pt 10pt; }
        body { font-family: "DejaVu Sans Mono", monospace; font-size: 9.5pt; color: #000; margin: 0; }
        .line { white-space: pre; line-height: 1.3; }
        .bold { font-weight: bold; }
    </style>
</head>
<body>
{% for row in rows %}
    <div class="line{% if row.bold %} bold{% endif %}">{{ row.text == '' ? ' ' : row.text }}</div>
{% endfor %}
</body>
</html>
