APP_ENV=dev
TPV_URL=https://tpv.tudominio.com
# URL path prefix of the app: empty on its own (sub)domain, /tpv under http://localhost/tpv
TPV_BASE_PATH=
APP_ADMIN_USER=
APP_ADMIN_PASSWORD=
APP_SECRET=
JWT_SECRET=
SSO_SHARED_SECRET=

TPV_DB_HOST=127.0.0.1
TPV_DB_PORT=3306
TPV_DB_NAME=
TPV_DB_USER=
TPV_DB_PASSWORD=

TPV_STORE_NAME="Mi Tienda"
TPV_STORE_ADDRESS="Calle Principal 123"

# PrestaShop
PS_SHOP_URL=
PS_API_KEY=

# PrestaShop defaults
PS_DEFAULT_CURRENCY=
PS_DEFAULT_SHOP=
# Coupon expiry dates use this shop-local timezone (Europe/Madrid is the current target shop).
PS_SHOP_TIMEZONE=Europe/Madrid

# Native coupon checkout: keep disabled until TPV Connect >= 0.2.0 is installed
# and coupon_preview has been verified in an isolated test environment.
TPV_COUPON_CHECKOUT_ENABLED=0

# Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default

# Reverse proxy (Plesk: nginx in front of Apache). Comma-separated proxies whose
# X-Forwarded-For / X-Forwarded-Proto are trusted, so rate limits and the print
# agent's last IP see the real client. Empty: no proxy is trusted (local install).
# Plesk: TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES=
