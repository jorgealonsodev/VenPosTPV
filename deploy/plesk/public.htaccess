# public/.htaccess for Plesk (PHP-FPM served by Apache behind nginx).
# The local XAMPP copy pins a PHP 8.5 CGI wrapper; Plesk picks PHP per domain.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The print agent authenticates with "Authorization: Bearer"; pass it to PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The bare address opens the TPV (the app itself has no page at /).
    RewriteRule ^$ /app/pos [R=302,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
