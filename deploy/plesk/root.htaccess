# VenPosTPV: forward-to-public
# The subdomain's document root can stay on this folder: every request is
# served from public/ internally, so .env, vendor/, src/ and var/ are never
# reachable from the web. (The installer checks the first line of this file.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^public/ - [L]
    # The installer stub in this folder (removed once the TPV is installed).
    RewriteRule ^install\.php$ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
